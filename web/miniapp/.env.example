# Backend API base URL (no trailing slash). MUST include https:// in production.
# Wrong: dentalproject-production-xxx.up.railway.app
# Right:  https://dentalproject-production-xxx.up.railway.app
VITE_API_BASE_URL=http://localhost:8080

# Set to "true" to log API errors to console and show HTTP hints on screen (npm run dev enables this automatically)
# VITE_DEBUG=true
