# Required
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
DATABASE_URL=postgres://dental:dental@localhost:5432/dental?sslmode=disable

# JWT signing secret (min 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional: must match Telegram setWebhook secret_token if you enable it
TELEGRAM_WEBHOOK_SECRET=

# Gemini model id (must support vision + JSON MIME type)
GEMINI_MODEL=gemini-1.5-flash

# HTTP listen address inside the container
HTTP_ADDR=:8080

# Auth
JWT_TTL=24h
TELEGRAM_AUTH_MAX_AGE=24h

# CORS for Mini App dev (comma-separated origins). Empty allows reflecting request Origin.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Telegram user IDs of doctors (comma-separated). They can GET /appointments and see all patient bookings.
DOCTOR_TELEGRAM_IDS=

# Optional tuning
REQUEST_TIMEOUT=55s
GEMINI_HTTP_TIMEOUT=60s
TELEGRAM_DOWNLOAD_TIMEOUT=30s
MAX_IMAGE_DIMENSION=1024

# Logging
LOG_LEVEL=info

# Compose only
HOST_PORT=8080
POSTGRES_PORT=5432
