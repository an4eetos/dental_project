{   "global": {     "max_file_lines": 800,     "enforce_screaming_architecture": true,     "no_cyclic_dependencies": true,     "contextual_import_rules": true   },   "folders": {     "cmd": {       "rules": [         "main.go MUST only contain fx.New and fx.Invoke",         "No business logic allowed",         "No config parsing allowed"       ]     },     "internal": {       "rules": [         "All business logic MUST reside in domain/service/usecase",         "Adapters MUST implement ports",         "No domain logic in adapters",         "Domain MUST NOT import adapters, infra, or pkg",         "Usecase MAY orchestrate multiple adapters and ports"       ],       "subfolders": {         "domain/global/errors": {           "rules": [             "All domain errors MUST implement DomainError interface",             "Errors MUST have constant messages",             "Adapters MUST translate DomainError into transport-specific error",             "No fmt.Errorf in domain or usecase"           ]         },         "port": {           "rules": [             "Ports MUST be interfaces only",             "One concern per file",             "No structs or implementation logic",             "Usecases depend only on ports, not adapters directly"           ]         },         "adapters/driven": {           "rules": [             "Driven adapters implement ports",             "No business logic in driven adapters",             "Adapters may expose transactional methods if needed",             "No direct event publishing inside adapters"           ]         },         "adapters/driving": {           "rules": [             "Driving adapters handle HTTP/gRPC consumers",             "No business logic, only adapters + converters",             "Converters MUST be organized by request/response",             "Handlers MUST inject usecases via fx"           ]         },         "usecase": {           "rules": [             "Usecases orchestrate domain, services, driven adapters, and events",             "Transactions MUST be wrapped via TxManager",             "Event publishing MUST be done via EventPublisher port",             "No direct adapter calls inside domain logic"           ]         },         "service": {           "rules": [             "Service functions MUST be small, stateless units",             "Service MAY call other services in same context",             "No adapter access from services"           ]         }       }     },     "infra": {       "rules": [         "Infra wires configuration + pkg utilities",         "No business logic allowed in infra",         "Adapters and usecases injected via fx.Provide",         "Cron jobs, workers, and HTTP clients live here",         "Modules MAY import pkg but NOT internal"       ],       "subfolders": {         "http": {           "rules": ["HTTP clients, hooks, resty wrappers only"]         },         "postgresql": {           "rules": ["Connect to DB using config struct", "No domain logic", "Expose TxManager module"]         },         "cron": {           "rules": ["Initialize cron jobs using config only"]         },         "worker": {           "rules": ["Background job consumers, Kafka consumers, retry queues"]         }       }     },     "pkg": {       "rules": [         "Pkg MUST be reusable across projects",         "No imports from internal",         "Pkg contains generic infra utilities: DB, Redis, Kafka, metrics"       ]     }   },   "errors": {     "domain_error_interface_required": true,     "typed_errors_only": true,     "adapters_translate_errors": true,     "no_fmterrorf_in_domain": true   },   "transactions": {     "tx_manager_required": true,     "usecases_wrap_transactions": true,     "events_must_use_eventpublisher": true,     "driven_adapters_expose_tx_methods_if_needed": true   },   "fx": {     "module_per_context": true,     "fx_invoke_no_business_logic": true,     "adapters_use_fx_provide_only": true,     "usecases_use_fx_provide_only": true,     "modules_must_not_import_private_types_from_others": true   },   "events": {     "events_must_use_eventpublisher_port": true,     "event_publication_must_be_orchestrated": true,     "events_after_successful_tx": true   },   "file_size": {     "max_lines_per_file": 800   },   "testing": {     "domain": "pure unit tests only",     "usecase": "mock ports/adapters",     "adapters": "integration tests only"   },   "config": {     "no_viper_allowed": true,     "strongly_typed_structs": true,     "parsing_only_in_infra": true   },   "naming": {     "folders_must_be_business_contexts": true,     "files_must_reflect_purpose": true,     "adapters_converters_must_be_in_converters_folder": true   } }
